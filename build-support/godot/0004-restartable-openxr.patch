+	}
+	runtime_lost = true;
+	running = false;
+	session_state = XR_SESSION_STATE_LOSS_PENDING;
+	set_render_session_running(false);
+	set_render_display_info(0, false);
+	if (xr_interface) {
+		xr_interface->on_state_loss_pending();
+	}
