+bool OpenXRVulkanExtension::prepare_existing_device() {
+	if (!late_attachment) {
+		return true;
+	}
+	RenderingDevice *rd = RenderingDevice::get_singleton();
+	ERR_FAIL_NULL_V(rd, false);
+	OpenXRAPI *api = OpenXRAPI::get_singleton();
+	vulkan_instance = (VkInstance)rd->get_driver_resource(RenderingDevice::DRIVER_RESOURCE_TOPMOST_OBJECT, RID(), 0);
+	vulkan_device = (VkDevice)rd->get_driver_resource(RenderingDevice::DRIVER_RESOURCE_LOGICAL_DEVICE, RID(), 0);
+	const InstanceInfo *instance_info = instances.getptr((uint64_t)vulkan_instance);
+	const DeviceInfo *device_info = devices.getptr((uint64_t)vulkan_device);
+	ERR_FAIL_COND_V_MSG(!instance_info || !device_info, false, "OpenXR: desktop Vulkan device metadata unavailable.");
+	vulkan_physical_device = device_info->physical_device;
+	vulkan_queue_family_index = device_info->queue_family;
+	vulkan_queue_index = device_info->queue_index;
+	ERR_FAIL_COND_V(vulkan_queue_family_index == UINT32_MAX, false);
+
+	PFN_xrGetVulkanGraphicsRequirementsKHR requirements_fn = nullptr;
+	PFN_xrGetVulkanGraphicsDeviceKHR physical_device_fn = nullptr;
+	PFN_xrGetVulkanInstanceExtensionsKHR instance_extensions_fn = nullptr;
+	PFN_xrGetVulkanDeviceExtensionsKHR device_extensions_fn = nullptr;
+	api->get_instance_proc_addr("xrGetVulkanGraphicsRequirementsKHR", (PFN_xrVoidFunction *)&requirements_fn);
+	api->get_instance_proc_addr("xrGetVulkanGraphicsDeviceKHR", (PFN_xrVoidFunction *)&physical_device_fn);
+	api->get_instance_proc_addr("xrGetVulkanInstanceExtensionsKHR", (PFN_xrVoidFunction *)&instance_extensions_fn);
+	api->get_instance_proc_addr("xrGetVulkanDeviceExtensionsKHR", (PFN_xrVoidFunction *)&device_extensions_fn);
+	ERR_FAIL_COND_V(!requirements_fn || !physical_device_fn || !instance_extensions_fn || !device_extensions_fn, false);
+	XrGraphicsRequirementsVulkanKHR requirements = { XR_TYPE_GRAPHICS_REQUIREMENTS_VULKAN_KHR, nullptr, 0, 0 };
+	if (XR_FAILED(requirements_fn(api->get_instance(), api->get_system_id(), &requirements))) {
+		return false;
+	}
+	XrVersion version = XR_MAKE_VERSION(VK_VERSION_MAJOR(instance_info->api_version), VK_VERSION_MINOR(instance_info->api_version), VK_VERSION_PATCH(instance_info->api_version));
+	ERR_FAIL_COND_V_MSG(version < requirements.minApiVersionSupported, false, "OpenXR requires a newer Vulkan API than this desktop device.");
+	VkPhysicalDevice required_device = VK_NULL_HANDLE;
+	if (XR_FAILED(physical_device_fn(api->get_instance(), api->get_system_id(), vulkan_instance, &required_device))) {
+		return false;
+	}
+	ERR_FAIL_COND_V_MSG(required_device != vulkan_physical_device, false, "OpenXR and Prim are using different GPUs. Start Prim on the headset GPU.");
+	for (int kind = 0; kind < 2; kind++) {
+		uint32_t size = 0;
+		// Both extension-query functions have the same signature.
+		auto query = kind == 0 ? instance_extensions_fn : device_extensions_fn;
+		if (XR_FAILED(query(api->get_instance(), api->get_system_id(), 0, &size, nullptr))) {
+			return false;
+		}
+		Vector<char> buffer;
+		buffer.resize(MAX(size, 1u));
+		buffer.write[0] = 0;
+		if (XR_FAILED(query(api->get_instance(), api->get_system_id(), size, &size, buffer.ptrw()))) {
+			return false;
+		}
+		const Vector<String> &enabled = kind == 0 ? instance_info->extensions : device_info->extensions;
+		for (const String &extension : String(buffer.ptr()).split(" ", false)) {
+			ERR_FAIL_COND_V_MSG(!enabled.has(extension), false, "OpenXR requires an extension not enabled on the desktop Vulkan device: " + extension);
+		}
+	}
+	return true;
 }
 
