+void VulkanHooks::record_instance(VkInstance p_instance, const VkInstanceCreateInfo &p_info) {
+	InstanceInfo info;
+	info.api_version = p_info.pApplicationInfo->apiVersion;
+	for (uint32_t i = 0; i < p_info.enabledExtensionCount; i++) {
+		info.extensions.push_back(String(p_info.ppEnabledExtensionNames[i]));
+	}
+	instances[(uint64_t)p_instance] = info;
+}
+
+void VulkanHooks::record_device(VkDevice p_device, VkPhysicalDevice p_physical_device, const VkDeviceCreateInfo &p_info) {
+	DeviceInfo info;
+	info.physical_device = p_physical_device;
+	for (uint32_t i = 0; i < p_info.enabledExtensionCount; i++) {
+		info.extensions.push_back(String(p_info.ppEnabledExtensionNames[i]));
+	}
+	devices[(uint64_t)p_device] = info;
+}
+
+void VulkanHooks::record_queue(VkDevice p_device, uint32_t p_family, uint32_t p_index) {
+	DeviceInfo *info = devices.getptr((uint64_t)p_device);
+	if (info) {
+		info->queue_family = p_family;
+		info->queue_index = p_index;
+	}
+}
 
