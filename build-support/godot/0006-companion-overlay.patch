+
+Dictionary OpenXRAPI::get_overlay_status() const {
+	Dictionary status;
+	status["active"] = session != XR_NULL_HANDLE && overlay_session;
+	status["supported"] = overlay_available;
+	status["main_visible"] = overlay_main_visible;
+	status["visibility_serial"] = overlay_visibility_serial;
+	status["placement"] = overlay_placement;
+	return status;
+}
+
+void OpenXRAPI::_set_overlay_hidden_rt(bool p_hidden) {
+	ERR_NOT_ON_RENDER_THREAD;
+	get_singleton()->render_state.overlay_hidden = p_hidden;
+}
+
+void OpenXRAPI::set_overlay_hidden(bool p_hidden) {
+	RenderingServer::get_singleton()->call_on_render_thread(callable_mp_static(&OpenXRAPI::_set_overlay_hidden_rt).bind(p_hidden));
+}
