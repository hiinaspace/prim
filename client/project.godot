; Prim daemon client (loop room). A minimal room that is a client of `prim room`
; over room.sock (PrimClient in native/). Replaces main.gd's PrimSession wiring
; over rounds C1/C2; this round: roster, a bot marker, hot reload, probe hooks.
config_version=5

[application]
config/name="prim-loop"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/use_custom_user_dir=true
config/custom_user_dir_name="prim-loop"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720

[xr]
openxr/enabled=true
openxr/startup_alert=false
shaders/enabled=true
